# ==============================================================================
# CONFIGURATION DES SECRETS & AUTOMATISATION (INDUSTRIAL HUNTER - HOUDA TAZI)
# Copiez ce fichier vers .env pour tester localement, ou configurez ces variables dans :
# GitHub: Settings > Secrets and variables > Actions > New repository secret
# ==============================================================================

# 1. EXPÉDITION DES E-MAILS & CANDIDATURES
# Adresse automatisée d'envoi pour Houda
GMAIL_USER=tazihouda124@gmail.com

# Mot de passe d'application Google (16 lettres, généré sur https://myaccount.google.com/apppasswords)
# Attention: Nécessite que la validation en 2 étapes soit activée sur le compte Google tazihouda124@gmail.com
GMAIL_APP_PASSWORD=votre_mot_de_passe_application_16_lettres

# Option Alternative (Cloud Resend API - Gratuit 3000 mails/mois sur https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# 2. VEILLE ANONYME DIGEST (BULLETIN SURPRISE)
# L'adresse personnelle de Houda qui recevra le digest d'opportunités en surprise
DIGEST_RECIPIENT=tazihouda1108@gmail.com
DIGEST_ENABLED=true
DIGEST_SENDER_NAME=Veille Opportunités Génie Industriel

# 3. CONTRÔLE DE SÉCURITÉ (SIMULATION VS ENVOI RÉEL)
# Mettre à 'true' pour tester sans envoyer de vrais e-mails (Dry-Run sécurisé)
# Mettre à 'false' pour activer l'envoi réel des candidatures et du digest
DRY_RUN=true

# 4. POSTULATION AUTOMATISÉE SUR PLATEFORMES (OPTIONNEL)
# Cookie de session LinkedIn 'li_at' pour la postulation Easy Apply automatique
LINKEDIN_LI_AT=

# Compte ReKrute.com (si disponible)
REKRUTE_EMAIL=tazihouda124@gmail.com
REKRUTE_PASSWORD=

AUTO_PLATFORM_APPLY=false
AUTO_EASY_APPLY=false

# 5. ALERTES ET NOTIFICATIONS TEMPS RÉEL (OPTIONNEL)
# Telegram (Notification sur smartphone à chaque opportunité qualifiée)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook (Pour suivre les opportunités dans un salon privé Discord)
DISCORD_WEBHOOK_URL=

# 6. ENRICHISSEMENT IA (OPTIONNEL)
GEMINI_API_KEY=
